#!/usr/bin/env python3
"""
session-model-recommend — cheapest suitable model recommender (advisory only).

Joins live `opencode models` catalog (opencode + opencode-go) with
docs/research/registry/Model-Routing-Matrix.md to emit per-task cheapest
suitable model + runner-up + cost tier, plus staleness warnings.

ADVISORY ONLY: never auto-selects or overrides an operator-named model
(model-discipline rule #5). Operator choice remains authoritative.

Usage:
  scripts/session-model-recommend [--task-type <substr>] [--issue <num>]
                                  [--actual-model <model-id>] [--json]
                                  [--check-staleness-only] [--verbose]
                                  [--matrix <path>]

  --task-type <substr>   Filter routing table to task types matching substr
                         (case-insensitive substring).
  --issue <num>          Infer task type from issue labels (feature/research/
                         bug/review etc). Requires crosslink CLI.
  --actual-model <id>    Compare recommendation vs the model actually chosen
                         (cheapest-test): prints ADVISORY / OVERRIDE note.
  --json                 Machine-readable JSON output (still prints warnings).
  --check-staleness-only Only emit staleness/forbidden warnings.
  --verbose              Show catalog + matrix parse details.
  --matrix <path>        Override matrix path (default:
                         docs/research/registry/Model-Routing-Matrix.md).
  --help                 Show this help.

Examples:
  scripts/session-model-recommend
  scripts/session-model-recommend --task-type research --verbose
  scripts/session-model-recommend --issue 516 --actual-model opencode-go/muse-spark-1.2-contributor
  scripts/session-model-recommend --json | jq .

Maintenance: routing matrix refresh cadence is weekly or when `opencode models`
lists an ID not in the matrix (or vice versa). See Model-Routing-Matrix.md
§ Maintenance and model-discipline.md. Filed under epic #255 OPERATIONAL DATA.

Exit codes: 0 success (even with staleness warnings), 1 on catalog/matrix
read failure, 2 on bad args.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_MATRIX = "docs/research/registry/Model-Routing-Matrix.md"
