; Selector d=last decision, c=selected tenure, p=pending. One gate t,h,v.
(set-logic QF_LIA)
(declare-const d Int)
(declare-const c Int)
(declare-const p Bool)
(declare-const t Int)
(declare-const h Int)
(declare-const v Int)
(declare-const r Int)
(declare-const b Int)
(define-fun inv ((d Int) (c Int) (p Bool) (t Int) (h Int) (v Int)) Bool
  (and (<= 0 c) (<= c d) (<= c t) (<= 0 v) (<= v t)
       (<= t (+ d (ite p 1 0)))
       (or (= h (- 1)) (and (= h c) (<= t d)))))
(define-fun q () Int (+ d 1))
; Valid authentic summary (r,b) from the decision prefix.
(define-fun summary () Bool
  (and (<= 0 r) (<= r d) (<= 0 b) (<= b r) (=> (>= r c) (= b c))))
(push)
(assert (not (inv 0 0 false 0 0 0)))
(check-sat)
(pop)
(assert (inv d c p t h v))
(push)
(assert (not p))
(assert (not (inv d c true t h v)))
(check-sat)
(pop)
(push)
(assert (and (> r t) (<= r (+ d (ite p 1 0)))))
(assert (not (inv d c p r (- 1) r)))
(check-sat)
(pop)
(push)
(assert p)
(assert (not (inv q c false t h v)))
(check-sat)
(pop)
(push)
(assert (and p (>= v q)))
(assert (not (inv q q false t h v)))
(check-sat)
(pop)
(push)
(assert (and summary (>= r t)))
(assert (not (inv d c p r b v)))
(check-sat)
(pop)
; Mutations permit an older post-abort vote or a summary behind the gate.
(push)
(assert (and p (> v c)))
(assert (not (inv q q false t h v)))
(check-sat)
(pop)
(push)
(assert summary)
(assert (not (inv d c p r b v)))
(check-sat)
(pop)
