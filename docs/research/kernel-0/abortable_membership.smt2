; d is last decision, c last commit, m current membership at one arbitrary gate.
; u bounds decisions whose eligible summary is now obsolete at this gate.
(set-logic QF_LIA)
(declare-const d Int)
(declare-const c Int)
(declare-const m Bool)
(declare-const n Bool)
(declare-const p Bool)
(declare-const t Int)
(declare-const h Int)
(declare-const v Int)
(declare-const u Int)
(declare-const r Int)
(declare-const b Int)
(declare-const named Bool)
(define-fun inv ((d Int) (c Int) (m Bool) (p Bool) (t Int) (h Int) (v Int) (u Int)) Bool
  (and (<= 0 c) (<= c d) (<= 0 v) (<= v t)
       (<= t (+ d (ite p 1 0))) (<= (- 1) u) (< u d) (< u t)
       (or (= h (- 1)) (and (= h c) m (<= c t) (<= t d)))))
(define-fun q () Int (+ d 1))
(define-fun summary () Bool
  (and (<= 0 r) (<= r d) (<= 0 b) (<= b r)
       (=> named (or (<= r u) (and m (= b c))))))
(push)
(assert (not (inv 0 0 m false 0 (ite m 0 (- 1)) 0 (- 1))))
(check-sat)
(pop)
(assert (inv d c m p t h v u))
(push)
(assert (not p))
(assert (not (inv d c m true t h v u)))
(check-sat)
(pop)
(push)
(assert (and (> r t) (<= r (+ d (ite p 1 0)))))
(assert (not (inv d c m p r (- 1) r u)))
(check-sat)
(pop)
(push)
(assert p)
(assert (not (inv q c m false t h v u)))
(check-sat)
(pop)
(push)
(assert (and p (=> m (>= v q))))
(assert (not (inv q q n false t h v (ite m d u))))
(check-sat)
(pop)
(push)
(assert (and summary (>= r t)))
(assert (not (inv d c m p r (ite named b (- 1)) v u)))
(check-sat)
(pop)
(push)
(assert (and p (=> (and m n) (>= v q))))
(assert (not (inv q q n false t h v (ite m d u))))
(check-sat)
(pop)
; Satisfiable distinction: the absent gate need not have t >= c.
(push)
(assert (and p (not m) n (< t q)))
(check-sat)
(pop)
