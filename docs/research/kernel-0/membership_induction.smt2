; One arbitrary resource identity. u bounds its issued certificates older than e.
(set-logic QF_LIA)
(declare-const e Int)
(declare-const m Bool)
(declare-const u Int)
(declare-const f Int)
(declare-const h Int)
(declare-const n Bool)
(declare-const k Int)
(define-fun inv ((epoch Int) (member Bool) (prior Int) (floor Int) (open Int)) Bool
  (and (>= epoch 0) (>= floor 0) (<= floor (+ epoch 1))
       (>= prior (- 1)) (< prior epoch) (< prior floor)
       (or (= open (- 1)) (and member (= open epoch) (>= open floor)))))
(push)
(assert (not (inv 0 m (- 1) 0 (- 1))))
(check-sat)
(pop)
(assert (inv e m u f h))
; Prepare: advance floor before issuing receipt.
(push)
(assert m)
(assert (not (inv e m u (+ e 1) (- 1))))
(check-sat)
(pop)
; Delayed enable: all earlier authentic certificates are bounded by u.
(push)
(assert (and (>= k 0) (>= k f) (or (<= k u) (and m (= k e)))))
(assert (not (inv e m u f k)))
(check-sat)
(pop)
; Commit: only a current member needs a barrier receipt. Target membership n is arbitrary.
(push)
(assert (=> m (> f e)))
(assert (not (inv (+ e 1) n (ite m e u) f h)))
(check-sat)
(pop)
; Negative control: only old/new intersection signed.
(push)
(assert (=> (and m n) (> f e)))
(assert (not (inv (+ e 1) n (ite m e u) f h)))
(check-sat)
(pop)
; Negative control: scope acknowledgments to gates observed open.
(push)
(assert (=> (= h e) (> f e)))
(assert (not (inv (+ e 1) n (ite m e u) f h)))
(check-sat)
(pop)
