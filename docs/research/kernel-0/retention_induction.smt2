; d latest decision, c latest commit, m membership, p whether an attempt is pending.
(set-logic QF_LIA)
(declare-const d Int)
(declare-const c Int)
(declare-const m Bool)
(declare-const n Bool)
(declare-const p Bool)
(declare-const t Int)
(declare-const held Bool)
(declare-const v Int)
(declare-const r Int)
(declare-const named Bool)
(define-fun q () Int (+ d 1))
(define-fun inv ((d Int) (c Int) (m Bool) (p Bool) (t Int) (held Bool) (v Int)) Bool
  (and (<= 0 c) (<= c d) (<= 0 v) (<= v t) (<= t (+ d (ite p 1 0)))
       (=> m (and held (<= c t))) (=> (> t d) held)))
(define-fun summary () Bool (and (<= 0 r) (<= r d) (=> (>= r c) (= named m))))
(push)
(assert (not (inv 0 0 m false 0 m 0)))
(check-sat)
(pop)
(assert (inv d c m p t held v))
(push)
(assert (not p))
(assert (not (inv d c m true t held v)))
(check-sat)
(pop)
(push)
(assert (and (> r t) (<= r (+ d (ite p 1 0)))))
(assert (not (inv d c m p r true r)))
(check-sat)
(pop)
(push)
(assert p)
(assert (not (inv q c m false t held v)))
(check-sat)
(pop)
(push)
(assert (and p (=> n (>= v q))))
(assert (not (inv q q n false t held v)))
(check-sat)
(pop)
(push)
(assert (and summary (>= r t)))
(assert (not (inv d c m p r (and held named) v)))
(check-sat)
(pop)
(push)
(assert (and p (=> (and m n) (>= v q))))
(assert (not (inv q q n false t held v)))
(check-sat)
(pop)
(push)
(assert summary)
(assert (not (inv d c m p r (and held named) v)))
(check-sat)
(pop)
