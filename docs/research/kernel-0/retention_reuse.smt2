; One holder. a is the latest decided summary that excluded this identity.
(set-logic QF_LIA)
(declare-const d Int)
(declare-const m Bool)
(declare-const p Bool)
(declare-const t Int)
(declare-const held Bool)
(declare-const v Int)
(declare-const a Int)
(declare-const n Bool)
(declare-const r Int)
(declare-const named Bool)
(define-fun q () Int (+ d 1))
(define-fun inv ((d Int) (m Bool) (p Bool) (t Int) (held Bool) (v Int) (a Int)) Bool
  (and (<= 0 d) (<= 0 v) (<= v t) (<= t (+ d (ite p 1 0))) (<= (- 1) a) (<= a d)
       (ite m (and held (< a t) (< a d)) (= a d)) (=> (> t d) held)))
(define-fun joinVote () Bool (=> (and n (not m)) (>= v q)))
(define-fun validSummary () Bool
  (and (<= 0 r) (<= r d) (=> (not named) (<= r a))))
(push)
(assert (not (inv 0 m false 0 m 0 (ite m (- 1) 0))))
(check-sat)
(pop)
(assert (inv d m p t held v a))
(push)
(assert (not p))
(assert (not (inv d m true t held v a)))
(check-sat)
(pop)
(push)
(assert (and (> r t) (<= r (+ d (ite p 1 0)))))
(assert (not (inv d m p r true r a)))
(check-sat)
(pop)
(push)
(assert p)
(assert (not (inv q m false t held v (ite m a q))))
(check-sat)
(pop)
(push)
(assert (and p joinVote))
(assert (not (inv q n false t held v (ite n a q))))
(check-sat)
(pop)
(push)
(assert (and validSummary (>= r t)))
(assert (not (inv d m p r (and held named) v a)))
(check-sat)
(pop)
; Weaken a join to a point-in-time possession check.
(push)
(assert (and p (=> (and n (not m)) held)))
(assert (not (inv q n false t held v (ite n a q))))
(check-sat)
(pop)
; A continuous holder can safely span this commit with floor below q.
(push)
(assert (and p m n (< t q) (inv q n false t held v a)))
(check-sat)
(pop)
