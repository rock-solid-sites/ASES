{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["SESSION-START.md"],
  "plugin": [
    "./plugins/orchestrator-guard.ts",
    "./plugins/crosslink-guard.ts",
    "./plugins/rtk-guard.ts"
  ],
  "agent": {
    "orchestrator": {
      "path": ".opencode/agents/orchestrator.md",
      "mode": "primary"
    },
    "builder": {
      "path": ".opencode/agents/builder.md",
      "mode": "subagent"
    },
    "reviewer": {
      "path": ".opencode/agents/reviewer.md",
      "mode": "subagent"
    },
    "auditor": {
      "path": ".opencode/agents/auditor.md",
      "mode": "subagent"
    }
  },
  "mcp": {
    "github": {
      "enabled": false
    },
    "playwright": {
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2.0", "mcp-server-fetch==2026.7.10"],
      "enabled": true
    },
    "sqlite": {
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/claude-code/projects/ASES"],
      "enabled": true
    },
    "cloudflare": {
      "enabled": false
    }
  }
}
