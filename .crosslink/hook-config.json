          "git push --force",
          "git push -f",
          "git merge",
          "git rebase",
          "git cherry-pick",
          "git reset",
          "git reset --hard",
          "git clean",
          "git clean -f",
          "git clean -fd",
          "git clean -fdx",
          "git checkout .",
          "git restore .",
