  "blocked_git_commands": [
    "git push",
    "git rebase",
    "git cherry-pick",
    "git reset",
    "git checkout .",
    "git restore .",
    "git clean",
    "git stash",
    "git tag",
    "git am",
    "git apply",
    "git branch -d",
    "git branch -D",
    "git branch -m"
