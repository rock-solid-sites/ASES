    "default_agent": {
      "model": "opencode-go/deepseek-v4-pro",
      "timeout_minutes": 30,
      "verify": "local"
    },
    "enabled": false,
    "escalation": {
      "cooldown_minutes": 30,
      "enabled": true,
      "max_attempts": 2,
      "model": "claude-opus-4-6",
      "timeout_multiplier_pct": 150
    },
    "interval_minutes": 10,
    "max_concurrent_agents": 3,
    "sources": {
      "github_labels": {
        "enabled": true,
        "labels": [
          "agent-todo: replicate",
          "agent-todo: fix"
        ]
      }
    }
  },
  "sentinel.default_agent.model": "opencode/ling-3.0-flash-free",
  "signing_enforcement": "audit",
  "tracker_remote": "origin",
  "tracking_mode": "strict"
}