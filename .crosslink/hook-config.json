    "git branch",
    "git show",
    "jj log",
    "jj diff",
    "jj status",
    "jj show",
    "jj bookmark list",
    "ls",
    "dir",
    "pwd",
    "echo",
    "rtk read",
    "ps -o ",
    "pgrep ",
    "tmux list-sessions",
    "tmux capture-pane",
