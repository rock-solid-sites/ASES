            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "source_id",
          "target_ids",
          "relation"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "linked": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "depends_on",
                    "supersedes",
                    "relates_to"
                  ]
                }
              },
              "required": [
                "target_id",
                "relation"
              ]
            }
          },
          "created": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "source_id",
          "linked",
          "created"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "NotFound",
          "description": "Source or target artefact not found"
        },
        {
          "code": "ValidationFailed",
          "description": "Relation or ID pattern violated"
        },
        {
          "code": "Conflict",
          "description": "Link already exists"
        }
      ]
    },
    {
      "op_id": "archive_artefact",
      "title": "Archive artefact",
      "description": "Archive an artefact with a reason and optional superseding artefact reference.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "superseded_by": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          }
        },
        "required": [
          "artefact_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time"
          },
          "previous_status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          }
        },
        "required": [
          "artefact_id",
          "archived_at",
          "previous_status"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "NotFound",
          "description": "Artefact not found"
        },
        {
          "code": "ValidationFailed",
          "description": "Reason or superseded_by violates schema"
        },
        {
          "code": "Conflict",
          "description": "Artefact already archived"
        },
        {
          "code": "PolicyDenied",
          "description": "Caller lacks archive permission"
        }
      ]
    },
    {
      "op_id": "validate_payload",
      "title": "Validate payload",
      "description": "Validate an arbitrary payload against the authoritative schema for a given operation ID. Returns validation outcome and normalized payload.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "op_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "payload": {
            "type": "object"
          },
          "strict": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "op_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "constraint": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          },
          "normalized": {
            "type": "object"
          }
        },
        "required": [
          "valid"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "ValidationFailed",
          "description": "Payload is not an object or op_id missing"
        },
        {
          "code": "UnknownOperation",
          "description": "No capability with that op_id"
        }
      ]
    }
  ]
}