    {
      "op_id": "submit_evidence",
      "title": "Submit evidence",
      "description": "Attach evidence items to an artefact. Array/nested operation with optional note.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          },
          "evidence_items": {
            "type": "array",
            "description": "One or more evidence records",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 500
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "source",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "artefact_id",
          "evidence_items"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string"
          },
          "accepted_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[a-z0-9-]+$"
            }
          }
        },
        "required": [
          "artefact_id",
          "accepted_count",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "NotFound",
          "description": "Artefact not found"
        },
        {
          "code": "ValidationFailed",
          "description": "Evidence item violates schema"
        }
      ]
    },
    {
      "op_id": "link_artefacts",
      "title": "Link artefacts",
      "description": "Create directed links between artefacts with a typed relation.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^art_[a-z0-9-]+$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "relation": {
            "type": "string",
            "enum": [
              "depends_on",
              "supersedes",
              "relates_to"
            ]
          },
          "bidirectional": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "source_id",
          "target_ids",
          "relation"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "linked": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "depends_on",
                    "supersedes",
                    "relates_to"
                  ]
                }
              },
              "required": [
                "target_id",
                "relation"
              ]
            }
          },
          "created": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "source_id",
          "linked",
          "created"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "NotFound",
          "description": "Source or target artefact not found"
        },
        {
          "code": "ValidationFailed",
          "description": "Relation or ID pattern violated"
        },
        {
          "code": "Conflict",
          "description": "Link already exists"
        }
      ]
    },
    {
      "op_id": "archive_artefact",
      "title": "Archive artefact",
      "description": "Archive an artefact with a reason and optional superseding artefact reference.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "superseded_by": {
            "type": "string",
            "pattern": "^art_[a-z0-9-]+$"
          }
        },
        "required": [
          "artefact_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artefact_id": {
            "type": "string"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time"
          },
          "previous_status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          }
        },
        "required": [
          "artefact_id",
          "archived_at",
          "previous_status"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "NotFound",
          "description": "Artefact not found"
        },
        {
          "code": "ValidationFailed",
          "description": "Reason or superseded_by violates schema"
        },
        {
          "code": "Conflict",
          "description": "Artefact already archived"
        },
        {
          "code": "PolicyDenied",
          "description": "Caller lacks archive permission"
        }
      ]
    },
    {
      "op_id": "validate_payload",
      "title": "Validate payload",
      "description": "Validate an arbitrary payload against the authoritative schema for a given operation ID. Returns validation outcome and normalized payload.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "op_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "payload": {
            "type": "object"
          },
          "strict": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "op_id",
          "payload"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "constraint": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "code"
              ]
            }
          },
          "normalized": {
            "type": "object"
          }
        },
        "required": [
          "valid"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "ValidationFailed",
          "description": "Payload is not an object or op_id missing"
        },
        {
          "code": "UnknownOperation",
          "description": "No capability with that op_id"
        }
      ]
    },
    {
      "op_id": "search_users",
      "title": "Search users",
      "description": "Search users by free-text query with pagination. Returns matching users, total count, and pagination cursor.",
      "version": "0.1.0",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text search query for users",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "description": "Maximum results to return",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor",
            "pattern": "^cur_[a-z0-9]+$"
          },
          "department": {
            "type": "string",
            "description": "Filter by department",
            "enum": [
              "engineering",
              "product",
              "design",
              "marketing"
            ]
          },
          "include_inactive": {
            "type": "boolean",
            "description": "Include inactive users"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^usr_[a-z0-9-]+$"
                },
                "name": {
                  "type": "string"
                },
                "department": {
                  "type": "string",
                  "enum": [
                    "engineering",
                    "product",
                    "design",
                    "marketing"
                  ]
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "cursor": {
            "type": "string",
            "pattern": "^cur_[a-z0-9]+$"
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "total",
          "has_more"
        ],
        "additionalProperties": false
      },
      "errors": [
        {
          "code": "ValidationFailed",
          "description": "Query or pagination parameter violates schema constraints"
        },
        {
          "code": "PolicyDenied",
          "description": "Caller lacks permission to search users"
        }
      ]
    },
