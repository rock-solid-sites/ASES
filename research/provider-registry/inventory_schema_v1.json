{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rock-solid-sites/ASES/blob/main/research/provider-registry/inventory_schema_v1.json",
  "title": "ASES Inventory snapshot v1",
  "oneOf": [
    {
      "$ref": "#/$defs/known"
    },
    {
      "$ref": "#/$defs/potential"
    }
  ],
  "$defs": {
    "known": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "as_of_date",
        "status",
        "source_document",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "known_accounts"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string"
        },
        "source_document": {
          "type": "string"
        },
        "public_repository_redaction": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/account"
          }
        }
      },
      "additionalProperties": false
    },
    "potential": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "as_of_date",
        "status",
        "source_document",
        "model_notes",
        "records"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "potential_offers"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string"
        },
        "source_document": {
          "type": "string"
        },
        "model_notes": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/offer"
          }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "metric",
        "value",
        "unit",
        "period",
        "scope",
        "verified_for_current_account",
        "source"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "account_reported",
            "provider_advertised",
            "historical_advertisement",
            "historical_estimate",
            "historical_user_report"
          ]
        },
        "verified_for_current_account": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "meter": {
      "type": "object",
      "required": [
        "meter_id",
        "unit",
        "granted",
        "consumed",
        "remaining"
      ],
      "properties": {
        "meter_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "granted": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "consumed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "remaining": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "account_evidence",
        "offering_summary",
        "claims",
        "usage",
        "verification_next",
        "source_usage_description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "provider": {
          "type": "string"
        },
        "account_evidence": {
          "type": "object",
          "required": [
            "status",
            "last_live_verified_at",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "user_reported",
                "user_confirmed",
                "tool_observed"
              ]
            },
            "last_live_verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "offering_summary": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "usage": {
          "type": "object",
          "required": [
            "status",
            "observed_at",
            "period",
            "meters"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "provider_reported",
                "runtime_measured",
                "reconciled"
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "period": {
              "type": [
                "string",
                "null"
              ]
            },
            "meters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/meter"
              }
            }
          },
          "additionalProperties": false
        },
        "verification_next": {
          "type": "string"
        },
        "source_usage_description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "credit": {
      "type": "object",
      "required": [
        "advertised_usd",
        "conditional_max_usd",
        "currency",
        "awarded_usd",
        "consumed_usd",
        "remaining_usd"
      ],
      "properties": {
        "advertised_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "conditional_max_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "awarded_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "consumed_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "remaining_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "product",
        "audience",
        "kind",
        "eligibility_status",
        "redemption_status",
        "offer_current_status",
        "account_exists_status",
        "credit",
        "discount_percent",
        "validity_days",
        "validity_months",
        "eligible_new_customer_type",
        "project_use_restriction",
        "compute_equivalent_scenario",
        "requirements",
        "published_description",
        "published_value_notes",
        "source_urls",
        "source_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "provider": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "audience": {
          "enum": [
            "general",
            "hms_startup",
            "existing_account_review"
          ]
        },
        "kind": {
          "enum": [
            "signup_credit",
            "restricted_product_credit",
            "startup_credit",
            "rate_discount",
            "always_free",
            "payg_comparator",
            "managed_comparator"
          ]
        },
        "eligibility_status": {
          "const": "not_assessed"
        },
        "redemption_status": {
          "enum": [
            "not_redeemed",
            "not_applicable"
          ]
        },
        "offer_current_status": {
          "const": "not_rechecked"
        },
        "account_exists_status": {
          "enum": [
            "unknown",
            "user_reported"
          ]
        },
        "credit": {
          "$ref": "#/$defs/credit"
        },
        "discount_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "validity_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "validity_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "eligible_new_customer_type": {
          "type": "string"
        },
        "project_use_restriction": {
          "type": [
            "string",
            "null"
          ]
        },
        "compute_equivalent_scenario": {
          "type": [
            "object",
            "null"
          ]
        },
        "requirements": {
          "type": "string"
        },
        "published_description": {
          "type": "string"
        },
        "published_value_notes": {
          "type": "string"
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "source_status": {
          "type": "string"
        },
        "coupon_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_free_allowance_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "meter_id",
              "amount",
              "unit",
              "period",
              "verified_for_account"
            ],
            "properties": {
              "meter_id": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "verified_for_account": {
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "standard_x86_vm_credit_eligible": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
