{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rock-solid-sites/ASES/blob/proposal/resource-console-v01-2026-11-06/research/resource-console/contracts/snapshot.v1.schema.json",
  "title": "ASES Resource Console read-only snapshot projection v1 (EXPERIMENTAL)",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "source_revisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_revision"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_revision": {
      "type": "object",
      "required": [
        "ref",
        "revision",
        "as_of"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "resource_id",
        "provider_id",
        "product_id",
        "account_ref",
        "kind",
        "capabilities",
        "access_routes",
        "meters"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "account_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "host",
            "remote_compute",
            "inference",
            "storage",
            "automation",
            "deployment",
            "other"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "access_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "meters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meter"
          }
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "kind",
        "operations",
        "verification"
      ],
      "properties": {
        "kind": {
          "enum": [
            "provider_api",
            "local_cli",
            "github_connector",
            "mcp",
            "web",
            "other",
            "unknown"
          ]
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "enum": [
            "verified",
            "unverified",
            "unknown",
            "unavailable"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "meter": {
      "type": "object",
      "required": [
        "meter_id",
        "unit",
        "period",
        "remaining",
        "truth",
        "observed_at",
        "source_ref"
      ],
      "properties": {
        "meter_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "truth": {
          "enum": [
            "measured",
            "provider_reported",
            "user_reported",
            "estimated",
            "unknown",
            "stale",
            "disputed"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "truth": {
                "const": "unknown"
              }
            },
            "required": [
              "truth"
            ]
          },
          "then": {
            "properties": {
              "remaining": {
                "type": "null"
              },
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "remaining": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
